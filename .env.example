# MetaWrangler environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── Image tags (set to your Docker Hub username + desired tag) ─────────────────
# Match what you set in the DOCKERHUB_NAME action secret
METAWRANGLER_BACKEND_IMAGE=your-dockerhub-name/metawrangler-backend:latest
METAWRANGLER_FRONTEND_IMAGE=your-dockerhub-name/metawrangler-frontend:latest

# ── Backend config ──────────────────────────────────────────────────────────────

# Authentik forward-auth header names (injected by Traefik, lowercase)
AUTHENTIK_HEADER_UID=x-authentik-uid
AUTHENTIK_HEADER_EMAIL=x-authentik-email

# Allowed CORS origin — set to your actual domain
ALLOWED_ORIGIN=https://metawrangler.example.com

# Log level: debug | info | warn | error
LOG_LEVEL=info
