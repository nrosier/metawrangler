# MetaWrangler environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── Image tags (set to your GitHub Container Registry owner + desired tag) ────
# Images are published to ghcr.io/<owner>/metawrangler-* by .github/workflows/docker.yml
METAWRANGLER_BACKEND_IMAGE=ghcr.io/your-github-owner/metawrangler-backend:latest
METAWRANGLER_FRONTEND_IMAGE=ghcr.io/your-github-owner/metawrangler-frontend:latest

# ── Backend config ──────────────────────────────────────────────────────────────

# Authentik forward-auth header names (injected by Traefik, lowercase)
AUTHENTIK_HEADER_UID=x-authentik-uid
AUTHENTIK_HEADER_EMAIL=x-authentik-email
AUTHENTIK_HEADER_GROUPS=x-authentik-groups

# REQUIRED — the Authentik group whose members may add/edit/remove mounts.
# Everyone else gets read-only access to mount listing/health. The backend
# refuses to start if this is unset (SEC-03) — there is no "allow everyone"
# default, since mounts are a shared, global trust boundary.
AUTHENTIK_ADMIN_GROUP=metawrangler-admins

# Allowed CORS origin — set to your actual domain
ALLOWED_ORIGIN=https://metawrangler.example.com

# Log level: debug | info | warn | error
LOG_LEVEL=info
