{
  "name": "metawrangler",
  "version": "1.0.0",
  "private": true,
  "description": "MKV metadata editor with bulk edit and undo support",
  "scripts": {
    "test": "npm run test --workspaces",
    "test:e2e": "cd e2e && npm run test",
    "test:e2e:ui": "cd e2e && npm run test:ui",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
