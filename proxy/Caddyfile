{
  # Global options
  admin off
  # Uncomment for local dev / self-signed:
  # local_certs
}

metawrangler.example.com {
  # ── Authentik forward-auth ──────────────────────────────────────────────────
  # Replace https://authentik.example.com with your Authentik instance URL.
  # The forward_auth directive sends every request to Authentik for validation.
  # On success Authentik injects X-authentik-uid, X-authentik-email headers.

  forward_auth authentik:9000 {
    uri /outpost.goauthentik.io/auth/caddy

    # Copy the enriched headers back onto the request to the upstream
    copy_headers X-authentik-uid X-authentik-email X-authentik-groups X-authentik-name

    # Authentik outpost address (adjust to your docker service name / port)
    trusted_proxies private_ranges
  }

  # ── Security headers ────────────────────────────────────────────────────────
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss:; img-src 'self' data:; font-src 'self'"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
    -Server
  }

  # ── API + WebSocket → backend ────────────────────────────────────────────────
  handle /api/* {
    reverse_proxy backend:3001
  }

  handle /ws/* {
    reverse_proxy backend:3001 {
      header_up Connection "Upgrade"
      header_up Upgrade "websocket"
    }
  }

  # ── Everything else → frontend ───────────────────────────────────────────────
  handle {
    reverse_proxy frontend:8080
  }
}
